# Public site URL (used in metadataBase, sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=https://vixiai.co

# Educator (course-maker) app — destination for hero textarea hand-off.
# The hero form redirects to ${NEXT_PUBLIC_APP_URL}/signup?prompt=<encoded>;
# after auth, course-maker forwards the prompt into the AI wizard.
NEXT_PUBLIC_APP_URL=https://create.vixiai.co

# Learner platform — destination for course card clicks.
# Each card on the landing links to ${NEXT_PUBLIC_LEARNER_URL}/{courseId}.
NEXT_PUBLIC_LEARNER_URL=https://learn.vixiai.co

# Public API base used for SSR fetches (e.g. the Courses grid).
# Trailing slash NOT included.
NEXT_PUBLIC_API_URL=https://learn.vixiai.co/api

# ── Meta (Facebook) ads analytics ──────────────────────────────────────────
# Meta Pixel ID — the SAME numeric id used on every Vixi surface. Public (baked
# into the client bundle). Leave blank to disable the Pixel + CAPI entirely.
NEXT_PUBLIC_META_PIXEL_ID=
# Meta Conversions API access token — SERVER-ONLY secret (a Business System-User
# token is preferred). Set in the Vercel dashboard; never prefix with NEXT_PUBLIC.
META_CAPI_ACCESS_TOKEN=
# Temporary CAPI test-event code (Events Manager → Test Events). Blank in prod.
META_TEST_EVENT_CODE=
# ── PostHog product analytics ──────────────────────────────────────────────
# Public project key (phc_...) from PostHog Cloud EU — the SAME project used on
# create/learn so a visitor is one identity across surfaces. Public (client bundle).
NEXT_PUBLIC_POSTHOG_KEY=
# Ingestion host — EU cloud by default.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Graph API version for CAPI (optional; defaults to v21.0).
META_GRAPH_API_VERSION=v21.0

# PromoteKit affiliate tracking (organization id from PromoteKit dashboard → Setup → Integration). Empty = script not loaded.
NEXT_PUBLIC_PROMOTEKIT_ID=
# Where the "Apply now" CTAs on /affiliates send applicants (PromoteKit-hosted portal; custom domain later).
NEXT_PUBLIC_AFFILIATE_PORTAL_URL=https://vixi.promotekit.com
